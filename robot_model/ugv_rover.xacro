<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vision_ugv_rover">

  <!-- ==================== PARAMETRIC PROPERTIES ==================== -->
  <xacro:property name="chassis_length" value="0.52"/>
  <xacro:property name="chassis_width"  value="0.34"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="chassis_mass"   value="12.0"/>

  <xacro:property name="wheel_radius"   value="0.125"/>
  <xacro:property name="wheel_width"    value="0.08"/>
  <xacro:property name="wheel_mass"     value="1.8"/>
  <xacro:property name="wheelbase"      value="0.36"/>
  <xacro:property name="track_width"    value="0.44"/>

  <xacro:property name="camera_height"  value="0.325"/>
  <xacro:property name="camera_pitch"   value="0.314159"/> <!-- ~18 degrees downward -->

  <!-- Inertia helper macros -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (x*x + z*z)}" iyz="0.0"
               izz="${(m/12.0) * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2.0) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Base footprint & Link -->
  <link name="base_footprint"/>
  
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.165" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_gray"><color rgba="0.22 0.24 0.26 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- Wheel Macro -->
  <xacro:macro name="ugv_wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tread_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="0 ${y_reflect * 0.042} 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.01"/>
        </geometry>
        <material name="hub_orange"><color rgba="0.9 0.4 0.05 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * wheelbase / 2} ${y_reflect * track_width / 2} -0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Instantiate 4 Wheels -->
  <xacro:ugv_wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:ugv_wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:ugv_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:ugv_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- Sensor Mast & Camera -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.08 0.035"/></geometry>
      <material name="camera_blue"><color rgba="0.1 0.45 0.85 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.04 0.08 0.035"/></geometry>
    </collision>
    <xacro:box_inertia m="0.25" x="0.04" y="0.08" z="0.035"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.18 0 0.235" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
