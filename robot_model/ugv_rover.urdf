<?xml version="1.0"?>
<!-- =================================================================================== -->
<!-- Vision-Based Outdoor Navigation Unmanned Ground Vehicle (UGV)                     -->
<!-- 4WD Skid-Steer / Differential Drive Outdoor Exploration Rover                       -->
<!-- Compliant with ROS REP-103 (Coordinate Frames) & REP-105 (Mobile Robot)            -->
<!-- =================================================================================== -->
<robot name="vision_ugv_rover">

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <!-- Projection of base_link on the ground plane (Z=0) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.165" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK (CHASSIS) ==================== -->
  <link name="base_link">
    <!-- Visual Representation -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.52 0.34 0.15"/>
      </geometry>
      <material name="chassis_dark_gray">
        <color rgba="0.22 0.24 0.26 1.0"/>
      </material>
    </visual>
    
    <!-- Top Equipment Deck -->
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.46 0.30 0.015"/>
      </geometry>
      <material name="aluminum_plate">
        <color rgba="0.75 0.76 0.78 1.0"/>
      </material>
    </visual>

    <!-- Front Bumper / Skid Plate -->
    <visual>
      <origin xyz="0.27 0 -0.02" rpy="0 0.35 0"/>
      <geometry>
        <box size="0.08 0.32 0.012"/>
      </geometry>
      <material name="safety_yellow">
        <color rgba="0.95 0.75 0.05 1.0"/>
      </material>
    </visual>

    <!-- Rear Bumper -->
    <visual>
      <origin xyz="-0.27 0 -0.02" rpy="0 -0.35 0"/>
      <geometry>
        <box size="0.08 0.32 0.012"/>
      </geometry>
      <material name="safety_yellow">
        <color rgba="0.95 0.75 0.05 1.0"/>
      </material>
    </visual>

    <!-- Collision Geometry -->
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.36 0.17"/>
      </geometry>
    </collision>

    <!-- Inertial Tensor (Chassis Mass: 12.0 kg) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.138" ixy="0.0" ixz="0.0"
               iyy="0.293" iyz="0.0"
               izz="0.385"/>
    </inertial>
  </link>

  <!-- ==================== WHEEL MACRO DEFINITIONS ==================== -->
  <!-- Dimensions: Radius 0.125m, Width 0.08m, Wheelbase 0.36m, Track 0.44m -->

  <!-- FRONT LEFT WHEEL -->
  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
      <material name="tread_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0.042 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.01"/>
      </geometry>
      <material name="hub_orange">
        <color rgba="0.9 0.4 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.00798" ixy="0.0" ixz="0.0"
               iyy="0.00798" iyz="0.0"
               izz="0.01406"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.18 0.22 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT RIGHT WHEEL -->
  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
      <material name="tread_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.042 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.01"/>
      </geometry>
      <material name="hub_orange">
        <color rgba="0.9 0.4 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.00798" ixy="0.0" ixz="0.0"
               iyy="0.00798" iyz="0.0"
               izz="0.01406"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.18 -0.22 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR LEFT WHEEL -->
  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
      <material name="tread_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0.042 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.01"/>
      </geometry>
      <material name="hub_orange">
        <color rgba="0.9 0.4 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.00798" ixy="0.0" ixz="0.0"
               iyy="0.00798" iyz="0.0"
               izz="0.01406"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.18 0.22 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR RIGHT WHEEL -->
  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
      <material name="tread_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.042 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.01"/>
      </geometry>
      <material name="hub_orange">
        <color rgba="0.9 0.4 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.00798" ixy="0.0" ixz="0.0"
               iyy="0.00798" iyz="0.0"
               izz="0.01406"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.18 -0.22 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== SENSOR MAST & VISION CAMERA ==================== -->
  <!-- Mast structure -->
  <link name="sensor_mast_link">
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.16"/>
      </geometry>
      <material name="mast_black">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.16"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast_link"/>
    <origin xyz="0.15 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- Camera Body & Gimbal Platform (18 deg downward tilt) -->
  <link name="camera_link">
    <visual>
      <!-- Camera Enclosure -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.035"/>
      </geometry>
      <material name="camera_blue">
        <color rgba="0.1 0.45 0.85 1.0"/>
      </material>
    </visual>
    <!-- Camera Lens Barrel -->
    <visual>
      <origin xyz="0.025 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.015"/>
      </geometry>
      <material name="lens_glass">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.09 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00016" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00018"/>
    </inertial>
  </link>

  <!-- Camera joint tilted 18 degrees (0.314 rad) forward-down to capture outdoor ground path -->
  <joint name="camera_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="camera_link"/>
    <origin xyz="0.03 0 0.16" rpy="0 0.314159 0"/>
  </joint>

  <!-- Standard ROS Optical Frame (Z-forward, X-right, Y-down) -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- ==================== COMPUTE & ELECTRONICS ENCLOSURE ==================== -->
  <link name="electronics_box_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.20 0.06"/>
      </geometry>
      <material name="carbon_fiber">
        <color rgba="0.12 0.12 0.14 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.20 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0054" ixy="0" ixz="0" iyy="0.0065" iyz="0" izz="0.0109"/>
    </inertial>
  </link>

  <joint name="electronics_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="electronics_box_link"/>
    <origin xyz="-0.08 0 0.11" rpy="0 0 0"/>
  </joint>

  <!-- Antenna -->
  <link name="antenna_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.20"/>
      </geometry>
      <material name="antenna_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="antenna_joint" type="fixed">
    <parent link="electronics_box_link"/>
    <child link="antenna_link"/>
    <origin xyz="-0.08 0.07 0.03" rpy="0 0 0"/>
  </joint>

  <!-- ==================== GAZEBO SIMULATION PLUGINS ==================== -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  
  <gazebo reference="front_left_wheel_link">
    <mu1>1.4</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="front_right_wheel_link">
    <mu1>1.4</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="rear_left_wheel_link">
    <mu1>1.4</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="rear_right_wheel_link">
    <mu1>1.4</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <!-- Gazebo Camera Plugin matching vision_ugv pipeline (640x480, 20-30 FPS) -->
  <gazebo reference="camera_link">
    <material>Gazebo/Blue</material>
    <sensor type="camera" name="ugv_front_camera">
      <update_rate>30.0</update_rate>
      <camera name="front_camera">
        <horizontal_fov>1.085</horizontal_fov> <!-- ~62.2 degrees H-FOV -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.08</near>
          <far>100.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>ugv/front_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_optical_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Gazebo Skid-Steer / Differential Drive Plugin -->
  <gazebo>
    <plugin name="skid_steer_drive_controller" filename="libgazebo_ros_skid_steer_drive.so">
      <updateRate>50.0</updateRate>
      <robotNamespace>/ugv</robotNamespace>
      <leftFrontJoint>front_left_wheel_joint</leftFrontJoint>
      <rightFrontJoint>front_right_wheel_joint</rightFrontJoint>
      <leftRearJoint>rear_left_wheel_joint</leftRearJoint>
      <rightRearJoint>rear_right_wheel_joint</rightRearJoint>
      <wheelSeparation>0.44</wheelSeparation>
      <wheelDiameter>0.25</wheelDiameter>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <torque>25</torque>
      <topicName>cmd_vel</topicName>
      <broadcastTF>true</broadcastTF>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

</robot>
